@model CampusCare.Web.ViewModels.ComplaintDetailsViewModel
@{
    ViewData["Title"] = $"Complaint {Model.Complaint.ComplaintNumber}";
    var c = Model.Complaint;
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">
        <i class="bi bi-arrow-left me-1"></i> Back to My Complaints
    </a>
    <div class="d-flex flex-wrap justify-content-between align-items-center bg-white p-4 rounded-3 border shadow-sm">
        <div>
            <span class="badge bg-primary-subtle text-primary font-monospace fs-6 mb-2">@c.ComplaintNumber</span>
            <h2 class="fw-bold mb-1">@c.Title</h2>
            <p class="text-secondary mb-0"><i class="bi bi-geo-alt-fill text-danger me-1"></i> @c.Location</p>
        </div>
        <div class="mt-3 mt-md-0 text-md-end">
            <div class="mb-2">
                <span class="badge badge-status badge-@c.Status fs-6 px-3 py-2">@c.Status</span>
                <span class="badge badge-status badge-@c.Priority fs-6 px-3 py-2 ms-1">@c.Priority Priority</span>
                @if (c.IsEscalated)
                {
                    <span class="badge bg-danger fs-6 px-3 py-2 ms-1"><i class="bi bi-exclamation-triangle-fill"></i> Escalated</span>
                }
            </div>
            <div class="small text-muted">Submitted on @c.CreatedAt.ToString("MMMM dd, yyyy hh:mm tt")</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Details, Attachments, Resolution & Feedback -->
    <div class="col-lg-7">
        <!-- Description Card -->
        <div class="card card-custom border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-file-text me-2 text-primary"></i> Issue Description</h5>
            </div>
            <div class="card-body">
                <p class="text-dark fs-6" style="white-space: pre-line;">@c.Description</p>
                <div class="row g-3 mt-3 pt-3 border-top small text-secondary">
                    <div class="col-sm-6">
                        <strong>Category:</strong> <span class="badge bg-light text-dark border">@(c.Category?.Name ?? "Uncategorized")</span>
                    </div>
                    <div class="col-sm-6">
                        <strong>Assigned Department:</strong> <span class="fw-semibold text-dark">@(c.Department?.Name ?? "Pending")</span>
                    </div>
                    <div class="col-sm-6">
                        <strong>Assigned Staff:</strong> <span class="fw-semibold text-dark">@(c.AssignedStaff?.FullName ?? "Unassigned")</span>
                    </div>
                    <div class="col-sm-6">
                        <strong>Last Updated:</strong> <span>@(c.UpdatedAt?.ToString("MMM dd, yyyy hh:mm tt") ?? c.CreatedAt.ToString("MMM dd, yyyy hh:mm tt"))</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- AI Analysis Box -->
        @if (c.AIAnalysis != null)
        {
            <div class="card card-custom border-0 shadow-sm mb-4 bg-light-subtle" style="border-left: 4px solid #4f46e5 !important;">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2">
                        <i class="bi bi-robot text-primary fs-4 me-2"></i>
                        <h6 class="fw-bold text-primary mb-0">AI Triage Summary & Recommendations</h6>
                        <span class="badge bg-primary ms-auto">Model: @c.AIAnalysis.ModelUsed</span>
                    </div>
                    <p class="small text-dark mb-2"><strong>Generated Summary:</strong> @c.AIAnalysis.GeneratedSummary</p>
                    <div class="row g-2 small text-muted">
                        <div class="col-6"><strong>Suggested Category:</strong> @c.AIAnalysis.SuggestedCategory</div>
                        <div class="col-6"><strong>Suggested Priority:</strong> @c.AIAnalysis.SuggestedPriority</div>
                    </div>
                </div>
            </div>
        }

        <!-- Attachment Card -->
        @if (c.Attachments.Any())
        {
            <div class="card card-custom border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-paperclip me-2 text-primary"></i> Uploaded Attachments</h5>
                </div>
                <div class="card-body">
                    <div class="list-group">
                        @foreach (var file in c.Attachments)
                        {
                            <a href="@file.FilePath" target="_blank" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <div>
                                    <i class="bi bi-file-earmark-image text-info me-2 fs-5"></i>
                                    <span class="fw-semibold">@file.FileName</span>
                                </div>
                                <span class="badge bg-secondary rounded-pill">@(file.FileSize / 1024) KB</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Resolution & Feedback Card -->
        @if (c.Status == CampusCare.Core.Enums.ComplaintStatus.Resolved || c.Status == CampusCare.Core.Enums.ComplaintStatus.Closed)
        {
            <div class="card card-custom border-0 shadow-sm mb-4 border-success" style="border-left: 4px solid #10b981 !important;">
                <div class="card-header bg-success-subtle text-success py-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-check-circle-fill me-2"></i> Resolution Summary</h5>
                </div>
                <div class="card-body">
                    <p class="mb-2"><strong>Resolution Action:</strong></p>
                    <p class="text-dark bg-light p-3 rounded-3 mb-3">@(string.IsNullOrWhiteSpace(c.ResolutionDetails) ? "Issue has been resolved by department staff." : c.ResolutionDetails)</p>

                    @if (c.Feedback != null)
                    {
                        <div class="border-top pt-3">
                            <h6 class="fw-bold text-success"><i class="bi bi-star-fill text-warning me-1"></i> Student Feedback Submitted</h6>
                            <div class="mb-1">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= c.Feedback.Rating)
                                    {
                                        <i class="bi bi-star-fill text-warning"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star text-muted"></i>
                                    }
                                }
                                <span class="fw-bold ms-2">@c.Feedback.Rating / 5 Stars</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(c.Feedback.Comment))
                            {
                                <p class="small text-secondary mb-0">"@c.Feedback.Comment"</p>
                            }
                        </div>
                    }
                    else
                    {
                        <!-- Feedback Form -->
                        <div class="border-top pt-3">
                            <h6 class="fw-bold mb-2">Rate Your Satisfaction & Provide Feedback</h6>
                            <form asp-action="SubmitFeedback" method="post">
                                <input type="hidden" name="ComplaintId" value="@c.Id" />
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold">Rating (1 to 5 Stars):</label>
                                    <select name="Rating" class="form-select form-select-sm" style="max-width: 200px;">
                                        <option value="5">⭐⭐⭐⭐⭐ 5 - Excellent</option>
                                        <option value="4">⭐⭐⭐⭐ 4 - Good</option>
                                        <option value="3">⭐⭐⭐ 3 - Average</option>
                                        <option value="2">⭐⭐ 2 - Poor</option>
                                        <option value="1">⭐ 1 - Very Dissatisfied</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <textarea name="Comment" class="form-control form-control-sm" rows="2" placeholder="Optional comments regarding resolution quality..."></textarea>
                                </div>
                                <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-send me-1"></i> Submit Feedback</button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Right Column: Timeline & Comments -->
    <div class="col-lg-5">
        <!-- Status History Timeline -->
        <div class="card card-custom border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-clock-history me-2 text-primary"></i> Lifecycle Audit History</h5>
            </div>
            <div class="card-body">
                <div class="timeline">
                    @foreach (var history in c.History)
                    {
                        <div class="timeline-item">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold text-dark">@history.Action</span>
                                <span class="small text-muted">@history.Timestamp.ToString("MMM dd, hh:mm tt")</span>
                            </div>
                            <p class="small text-secondary mb-1">
                                By: <span class="fw-semibold">@(history.ChangedByUser?.FullName ?? "System Auto")</span>
                            </p>
                            @if (history.NewStatus != 0)
                            {
                                <div><span class="badge badge-status badge-@history.NewStatus">@history.NewStatus</span></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(history.Notes))
                            {
                                <p class="small text-muted mt-1 mb-0 italic">@history.Notes</p>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Comments & Messages -->
        <div class="card card-custom border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-chat-left-text me-2 text-primary"></i> Discussion Comments</h5>
            </div>
            <div class="card-body">
                <div class="mb-3" style="max-height: 300px; overflow-y: auto;">
                    @if (!c.Comments.Any(cm => !cm.IsInternalOnly))
                    {
                        <p class="text-muted small text-center my-3">No public comments yet.</p>
                    }
                    else
                    {
                        foreach (var comment in c.Comments.Where(cm => !cm.IsInternalOnly))
                        {
                            <div class="p-3 mb-2 rounded-3 bg-light border">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="small text-primary">@(comment.User?.FullName ?? "User")</strong>
                                    <span class="small text-muted" style="font-size: 0.75rem;">@comment.CreatedAt.ToString("MMM dd, hh:mm tt")</span>
                                </div>
                                <p class="small text-dark mb-0">@comment.CommentText</p>
                            </div>
                        }
                    }
                </div>

                <!-- Add Comment Form -->
                <form asp-action="AddComment" method="post">
                    <input type="hidden" name="id" value="@c.Id" />
                    <div class="input-group">
                        <input type="text" name="commentText" class="form-control form-control-sm" placeholder="Type a message..." required />
                        <button type="submit" class="btn btn-primary-custom btn-sm"><i class="bi bi-send"></i></button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

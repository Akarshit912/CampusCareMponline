@model CampusCare.Web.ViewModels.CreateComplaintViewModel
@{
    ViewData["Title"] = "Submit New Complaint";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-custom border-0 shadow-lg p-3">
            <div class="card-body">
                <div class="d-flex align-items-center mb-4">
                    <div class="rounded-circle p-3 bg-primary-subtle text-primary me-3">
                        <i class="bi bi-pencil-square fs-3"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0">Report Campus Issue</h3>
                        <p class="text-secondary small mb-0">AI will automatically analyze your description, suggest priority, and route to responsible department.</p>
                    </div>
                </div>

                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Complaint Title *</label>
                        <input asp-for="Title" class="form-control" placeholder="e.g. Wi-Fi Not Working in Computer Lab 3" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Location" class="form-label fw-semibold">Exact Location / Room *</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-geo-alt-fill text-danger"></i></span>
                                <input asp-for="Location" class="form-control" placeholder="e.g. Block B, Lab 3, 2nd Floor" />
                            </div>
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label fw-semibold">Category (Optional)</label>
                            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                                <option value="">-- Let AI Auto-Suggest Category --</option>
                            </select>
                            <span class="form-text small text-muted">Leave blank for automatic AI categorization.</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Detailed Problem Description *</label>
                        <textarea asp-for="Description" class="form-control" rows="5" placeholder="Provide full details of the issue, when it started, and impact on students..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Priority" class="form-label fw-semibold">Priority Level</label>
                            <select asp-for="Priority" asp-items="Html.GetEnumSelectList<CampusCare.Core.Enums.PriorityLevel>()" class="form-select">
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Attachment" class="form-label fw-semibold">Upload Photo / Document</label>
                            <input asp-for="Attachment" type="file" class="form-control" accept="image/*,.pdf,.doc,.docx" />
                            <span class="form-text small text-muted">Supports JPG, PNG, PDF (Max 5MB).</span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center border-top pt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
                        </a>
                        <button type="submit" class="btn btn-primary-custom px-4 py-2">
                            <i class="bi bi-send-fill me-1"></i> Submit Complaint
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

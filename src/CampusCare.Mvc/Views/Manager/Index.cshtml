@model CampusCare.Web.ViewModels.ManagerDashboardViewModel
@{
    ViewData["Title"] = $"{Model.DepartmentName} Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-kanban text-warning me-2"></i> @Model.DepartmentName Manager Dashboard</h2>
        <p class="text-secondary small mb-0">Oversee department workload, assign staff, and monitor escalated complaints</p>
    </div>
    <div class="btn-group">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm @(ViewBag.CurrentFilter == null ? "active" : "")">All Dept Issues</a>
        <a asp-action="Index" asp-route-filter="unassigned" class="btn btn-outline-danger btn-sm @(ViewBag.CurrentFilter == "unassigned" ? "active" : "")">Unassigned (@Model.UnassignedCount)</a>
        <a asp-action="Index" asp-route-filter="escalated" class="btn btn-outline-warning btn-sm @(ViewBag.CurrentFilter == "escalated" ? "active" : "")">Escalated (@Model.EscalatedCount)</a>
        <a asp-action="Index" asp-route-filter="resolved" class="btn btn-outline-success btn-sm @(ViewBag.CurrentFilter == "resolved" ? "active" : "")">Resolved</a>
    </div>
</div>

<!-- Counter Summary -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card card-custom p-3 border-0 bg-white shadow-sm">
            <h6 class="text-muted small fw-semibold text-uppercase mb-1">Total Complaints</h6>
            <h3 class="fw-extrabold mb-0">@Model.TotalDepartmentComplaints</h3>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card card-custom p-3 border-0 bg-white shadow-sm">
            <h6 class="text-muted small fw-semibold text-uppercase mb-1">Unassigned</h6>
            <h3 class="fw-extrabold mb-0 text-danger">@Model.UnassignedCount</h3>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card card-custom p-3 border-0 bg-white shadow-sm">
            <h6 class="text-muted small fw-semibold text-uppercase mb-1">In Progress</h6>
            <h3 class="fw-extrabold mb-0 text-warning">@Model.InProgressCount</h3>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card card-custom p-3 border-0 bg-white shadow-sm">
            <h6 class="text-muted small fw-semibold text-uppercase mb-1">Escalated SLA</h6>
            <h3 class="fw-extrabold mb-0 text-danger">@Model.EscalatedCount</h3>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Staff Workload Table -->
    <div class="col-lg-4">
        <div class="card card-custom border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-people me-2 text-primary"></i> Staff Workload</h5>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    @foreach (var staff in Model.StaffWorkload)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <div>
                                <div class="fw-bold text-dark">@staff.StaffName</div>
                                <div class="small text-muted">@staff.Email</div>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-primary rounded-pill" title="Active Assigned">@staff.ActiveAssignedCount Active</span>
                                <span class="badge bg-success rounded-pill" title="Resolved">@staff.ResolvedCount Done</span>
                            </div>
                        </li>
                    }
                    @if (!Model.StaffWorkload.Any())
                    {
                        <li class="list-group-item text-center text-muted py-3">No active staff members registered in department.</li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <!-- Department Complaints List -->
    <div class="col-lg-8">
        <div class="card card-custom border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-card-checklist me-2 text-primary"></i> Department Complaints</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Title & Student</th>
                                <th>Priority</th>
                                <th>Assigned Staff</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Complaints)
                            {
                                <tr>
                                    <td><span class="font-monospace fw-bold text-primary">@c.ComplaintNumber</span></td>
                                    <td>
                                        <div class="fw-semibold text-dark">@c.Title</div>
                                        <div class="small text-muted"><i class="bi bi-person me-1"></i> @(c.Student?.FullName ?? "Student")</div>
                                    </td>
                                    <td><span class="badge badge-status badge-@c.Priority">@c.Priority</span></td>
                                    <td>
                                        @if (c.AssignedStaff != null)
                                        {
                                            <span class="fw-semibold text-dark"><i class="bi bi-person-check text-success me-1"></i> @c.AssignedStaff.FullName</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Unassigned</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge badge-status badge-@c.Status">@c.Status</span>
                                        @if (c.IsEscalated)
                                        {
                                            <span class="badge bg-danger ms-1"><i class="bi bi-exclamation-triangle-fill"></i> Escalated</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="Assign" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                            <i class="bi bi-person-plus me-1"></i> Assign
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

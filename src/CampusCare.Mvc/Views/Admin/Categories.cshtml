@model IEnumerable<CampusCare.Core.Entities.ComplaintCategory>
@{
    ViewData["Title"] = "Category Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-tags text-primary me-2"></i> Category Management</h2>
        <p class="text-secondary small mb-0">Manage complaint categories and default department routing</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to Console
    </a>
</div>

<div class="row g-4">
    <!-- Category Creation Form -->
    <div class="col-lg-4">
        <div class="card card-custom border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-plus-circle me-2 text-primary"></i> Add Category</h5>
            </div>
            <div class="card-body">
                <form asp-action="CreateCategory" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Category Name *</label>
                        <input name="Name" class="form-control" placeholder="e.g. Electrical Safety" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Default Responsible Department *</label>
                        <select name="DefaultDepartmentId" asp-items="ViewBag.Departments" class="form-select" required></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description</label>
                        <textarea name="Description" class="form-control" rows="3" placeholder="Category scope..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary-custom w-100"><i class="bi bi-plus-lg me-1"></i> Create Category</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Category List Table -->
    <div class="col-lg-8">
        <div class="card card-custom border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Category Name</th>
                                <th>Description</th>
                                <th>Default Department</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cat in Model)
                            {
                                <tr>
                                    <td class="fw-bold text-dark">@cat.Name</td>
                                    <td class="small text-secondary">@cat.Description</td>
                                    <td><span class="badge bg-info text-dark">@(cat.DefaultDepartment?.Name ?? "Unassigned")</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@model CampusCare.Web.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Student Registration";
}

<div class="row justify-content-center my-4">
    <div class="col-md-6 col-lg-5">
        <div class="card auth-card border-0 p-4">
            <div class="card-body">
                <div class="text-center mb-4">
                    <i class="bi bi-person-plus-fill text-info display-4"></i>
                    <h3 class="fw-bold mt-2 mb-1">Create Student Account</h3>
                    <p class="text-muted small">Register to report & track college issues</p>
                </div>

                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="FullName" class="form-control" placeholder="John Doe" />
                        <label asp-for="FullName"><i class="bi bi-person me-1"></i> Full Name</label>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control" placeholder="student@college.com" />
                        <label asp-for="Email"><i class="bi bi-envelope me-1"></i> College Email Address</label>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Password" class="form-control" placeholder="Password" />
                        <label asp-for="Password"><i class="bi bi-key me-1"></i> Password</label>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm Password" />
                        <label asp-for="ConfirmPassword"><i class="bi bi-shield-check me-1"></i> Confirm Password</label>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-info text-dark font-weight-bold w-100 py-2 fs-6 shadow-sm">
                        <i class="bi bi-check-circle me-1"></i> Register Account
                    </button>
                </form>

                <div class="text-center mt-4">
                    <p class="small text-muted mb-0">Already registered? <a asp-action="Login" class="text-primary fw-semibold text-decoration-none">Sign In</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

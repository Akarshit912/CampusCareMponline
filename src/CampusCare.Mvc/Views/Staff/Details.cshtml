@model CampusCare.Web.ViewModels.UpdateStatusViewModel
@{
    var c = ViewBag.Complaint as CampusCare.Core.Entities.Complaint;
    ViewData["Title"] = $"Process Complaint {c?.ComplaintNumber}";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">
        <i class="bi bi-arrow-left me-1"></i> Back to Workdesk
    </a>
    @if (c != null)
    {
        <div class="d-flex flex-wrap justify-content-between align-items-center bg-white p-4 rounded-3 border shadow-sm">
            <div>
                <span class="badge bg-primary-subtle text-primary font-monospace fs-6 mb-2">@c.ComplaintNumber</span>
                <h2 class="fw-bold mb-1">@c.Title</h2>
                <p class="text-secondary mb-0"><i class="bi bi-geo-alt-fill text-danger me-1"></i> @c.Location | Student: <strong>@(c.Student?.FullName ?? "Unknown")</strong> (@c.Student?.Email)</p>
            </div>
            <div class="mt-3 mt-md-0 text-md-end">
                <span class="badge badge-status badge-@c.Status fs-6 px-3 py-2">@c.Status</span>
                <span class="badge badge-status badge-@c.Priority fs-6 px-3 py-2 ms-1">@c.Priority Priority</span>
                @if (c.IsEscalated)
                {
                    <span class="badge bg-danger fs-6 px-3 py-2 ms-1"><i class="bi bi-exclamation-triangle-fill"></i> Escalated</span>
                }
            </div>
        </div>
    }
</div>

@if (c != null)
{
    <div class="row g-4">
        <!-- Status Update & Resolution Form -->
        <div class="col-lg-7">
            <div class="card card-custom border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-sliders me-2 text-primary"></i> Update Complaint Status & Resolution</h5>
                </div>
                <div class="card-body">
                    <form asp-action="UpdateStatus" method="post">
                        <input type="hidden" asp-for="ComplaintId" />

                        <div class="mb-3">
                            <label asp-for="NewStatus" class="form-label fw-semibold">Target Status *</label>
                            <select asp-for="NewStatus" asp-items="Html.GetEnumSelectList<CampusCare.Core.Enums.ComplaintStatus>()" class="form-select"></select>
                            <span class="form-text small text-muted">Workflow rule: Move to <code>InProgress</code> when investigating, and <code>Resolved</code> upon completion.</span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ResolutionDetails" class="form-label fw-semibold">Resolution Actions / Fix Details</label>
                            <textarea asp-for="ResolutionDetails" class="form-control" rows="3" placeholder="Describe the physical/technical solution applied..."></textarea>
                            <span class="form-text small text-muted">Required when marking as Resolved.</span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CommentText" class="form-label fw-semibold">Add Progress Note / Comment</label>
                            <textarea asp-for="CommentText" class="form-control" rows="2" placeholder="Optional notes for history..."></textarea>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="IsInternalOnly" class="form-check-input" />
                            <label asp-for="IsInternalOnly" class="form-check-label text-secondary small">Internal Note Only (Hidden from Student)</label>
                        </div>

                        <button type="submit" class="btn btn-primary-custom w-100 py-2 fs-6">
                            <i class="bi bi-check-circle me-1"></i> Save Status Change & Resolution
                        </button>
                    </form>
                </div>
            </div>

            <!-- Issue Description -->
            <div class="card card-custom border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-file-text me-2 text-primary"></i> Original Student Report</h5>
                </div>
                <div class="card-body">
                    <p class="fs-6" style="white-space: pre-line;">@c.Description</p>
                </div>
            </div>
        </div>

        <!-- History & Discussion -->
        <div class="col-lg-5">
            <!-- Timeline -->
            <div class="card card-custom border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-clock-history me-2 text-primary"></i> Audit Log</h5>
                </div>
                <div class="card-body">
                    <div class="timeline">
                        @foreach (var h in c.History)
                        {
                            <div class="timeline-item">
                                <div class="fw-bold text-dark">@h.Action</div>
                                <div class="small text-muted mb-1">@h.Timestamp.ToString("MMM dd, hh:mm tt") by @(h.ChangedByUser?.FullName ?? "System")</div>
                                @if (h.NewStatus != 0)
                                {
                                    <span class="badge badge-status badge-@h.NewStatus">@h.NewStatus</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(h.Notes))
                                {
                                    <p class="small text-muted mt-1 mb-0">@h.Notes</p>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Discussion -->
            <div class="card card-custom border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-chat-left-text me-2 text-primary"></i> Comments</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3" style="max-height: 250px; overflow-y: auto;">
                        @foreach (var cm in c.Comments)
                        {
                            <div class="p-2 mb-2 rounded-3 @(cm.IsInternalOnly ? "bg-warning-subtle border-warning" : "bg-light border") border">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="small text-dark">
                                        @(cm.User?.FullName ?? "User")
                                        @if (cm.IsInternalOnly) { <span class="badge bg-warning text-dark ms-1">Internal Note</span> }
                                    </strong>
                                    <span class="small text-muted" style="font-size: 0.7rem;">@cm.CreatedAt.ToString("MMM dd, hh:mm tt")</span>
                                </div>
                                <p class="small text-dark mb-0">@cm.CommentText</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

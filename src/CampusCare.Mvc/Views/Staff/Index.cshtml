@model CampusCare.Web.ViewModels.StaffDashboardViewModel
@{
    ViewData["Title"] = "Staff Workdesk";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-card-checklist text-info me-2"></i> Staff Workdesk</h2>
        <p class="text-secondary small mb-0">Manage and resolve complaints assigned to you</p>
    </div>
    <div class="btn-group">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm @(ViewBag.StatusFilter == null ? "active" : "")">All</a>
        <a asp-action="Index" asp-route-statusFilter="Assigned" class="btn btn-outline-info btn-sm @(ViewBag.StatusFilter == "Assigned" ? "active" : "")">Assigned</a>
        <a asp-action="Index" asp-route-statusFilter="InProgress" class="btn btn-outline-warning btn-sm @(ViewBag.StatusFilter == "InProgress" ? "active" : "")">In Progress</a>
        <a asp-action="Index" asp-route-statusFilter="Escalated" class="btn btn-outline-danger btn-sm @(ViewBag.StatusFilter == "Escalated" ? "active" : "")">Escalated</a>
        <a asp-action="Index" asp-route-statusFilter="Resolved" class="btn btn-outline-success btn-sm @(ViewBag.StatusFilter == "Resolved" ? "active" : "")">Resolved</a>
    </div>
</div>

<!-- Stats Row -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-3">
        <div class="card card-custom p-3 border-0 bg-white shadow-sm">
            <h6 class="text-muted small fw-semibold text-uppercase mb-1">Total Assigned</h6>
            <h3 class="fw-extrabold mb-0">@Model.TotalAssigned</h3>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card card-custom p-3 border-0 bg-white shadow-sm">
            <h6 class="text-muted small fw-semibold text-uppercase mb-1">Pending Action</h6>
            <h3 class="fw-extrabold mb-0 text-info">@Model.PendingAction</h3>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card card-custom p-3 border-0 bg-white shadow-sm">
            <h6 class="text-muted small fw-semibold text-uppercase mb-1">In Progress</h6>
            <h3 class="fw-extrabold mb-0 text-warning">@Model.InProgress</h3>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card card-custom p-3 border-0 bg-white shadow-sm">
            <h6 class="text-muted small fw-semibold text-uppercase mb-1">Resolved</h6>
            <h3 class="fw-extrabold mb-0 text-success">@Model.Resolved</h3>
        </div>
    </div>
</div>

<!-- Assigned Complaints Table -->
<div class="card card-custom border-0 shadow-sm">
    <div class="card-header bg-white py-3">
        <h5 class="fw-bold mb-0"><i class="bi bi-list-task me-2 text-secondary"></i> Assigned Complaints List</h5>
    </div>
    <div class="card-body p-0">
        @if (!Model.Complaints.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-check2-circle text-success display-4"></i>
                <p class="text-muted mt-3">No assigned complaints matching current filter.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Complaint ID</th>
                            <th>Student & Title</th>
                            <th>Location</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Created Date</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Complaints)
                        {
                            <tr>
                                <td>
                                    <span class="font-monospace fw-bold text-primary">@c.ComplaintNumber</span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@c.Title</div>
                                    <div class="small text-muted"><i class="bi bi-person me-1"></i> @(c.Student?.FullName ?? c.StudentId)</div>
                                </td>
                                <td class="small"><i class="bi bi-geo-alt me-1 text-danger"></i> @c.Location</td>
                                <td><span class="badge badge-status badge-@c.Priority">@c.Priority</span></td>
                                <td>
                                    <span class="badge badge-status badge-@c.Status">@c.Status</span>
                                    @if (c.IsEscalated)
                                    {
                                        <span class="badge bg-danger ms-1"><i class="bi bi-exclamation-triangle-fill"></i> Escalated</span>
                                    }
                                </td>
                                <td class="small text-muted">@c.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-primary-custom">
                                        <i class="bi bi-gear-fill me-1"></i> Process Issue
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

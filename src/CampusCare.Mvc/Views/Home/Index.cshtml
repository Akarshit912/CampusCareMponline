@{
    ViewData["Title"] = "CampusCare - Smart College Complaint System";
}

<div class="row align-items-center my-5 py-4">
    <div class="col-lg-7 mb-4 mb-lg-0">
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2 mb-3">
            <i class="bi bi-stars me-1"></i> AI-Powered & Automated Campus Support
        </span>
        <h1 class="display-4 fw-extrabold text-dark tracking-tight mb-3">
            Centralized Smart College <span class="text-primary">Complaint System</span>
        </h1>
        <p class="lead text-secondary mb-4">
            CampusCare connects Students, Department Managers, and Staff members in a single transparent portal with AI categorization, automated n8n escalation, and instant status tracking.
        </p>
        <div class="d-flex gap-3">
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary-custom btn-lg shadow-sm">
                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to Portal
            </a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-outline-secondary btn-lg rounded-3">
                <i class="bi bi-person-plus me-1"></i> Register Student Account
            </a>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card card-custom p-4 bg-white border-0 shadow-lg">
            <h5 class="fw-bold mb-3"><i class="bi bi-lightning-charge-fill text-warning me-2"></i> How CampusCare Works</h5>
            <div class="timeline">
                <div class="timeline-item">
                    <h6 class="fw-bold mb-1">1. Student Submits Issue</h6>
                    <p class="small text-muted mb-0">Attach details & photo for Wi-Fi, Lab, Hostel or Facility problems.</p>
                </div>
                <div class="timeline-item">
                    <h6 class="fw-bold mb-1">2. AI Analyzes & Routes</h6>
                    <p class="small text-muted mb-0">Smart engine detects category, priority, and assigns default department.</p>
                </div>
                <div class="timeline-item">
                    <h6 class="fw-bold mb-1">3. Department Manager Assigns</h6>
                    <p class="small text-muted mb-0">Manager delegates to specialized staff with workload tracking.</p>
                </div>
                <div class="timeline-item">
                    <h6 class="fw-bold mb-1">4. Staff Resolves & Student Rates</h6>
                    <p class="small text-muted mb-0">Real-time status updates, n8n notifications, and feedback rating.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 my-4">
    <div class="col-md-4">
        <div class="card card-custom h-100 p-4 border-0 shadow-sm">
            <i class="bi bi-cpu text-primary display-5 mb-3"></i>
            <h5 class="fw-bold">AI Category & Priority</h5>
            <p class="text-secondary small">Automatically classifies complaints by text pattern matching and LLM analysis for rapid triage.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-custom h-100 p-4 border-0 shadow-sm">
            <i class="bi bi-alarm-fill text-danger display-5 mb-3"></i>
            <h5 class="fw-bold">Automated SLA Escalation</h5>
            <p class="text-secondary small">Overdue complaints trigger automated n8n webhooks and notify managers before SLA breach.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-custom h-100 p-4 border-0 shadow-sm">
            <i class="bi bi-graph-up-arrow text-success display-5 mb-3"></i>
            <h5 class="fw-bold">Admin Analytics</h5>
            <p class="text-secondary small">Comprehensive department performance dashboards, average resolution speed, and student satisfaction index.</p>
        </div>
    </div>
</div>
